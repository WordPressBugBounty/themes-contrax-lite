                    "textDecoration": "none",
                    "fontFamily": "var:preset|font-family|almarai"
                },
                "color": {
                    "text": "var:preset|color|gv-color-primary"
                }
            },
            "heading": {
                "typography": {
                    "fontFamily": "var:preset|font-family|almarai"
                },
                "color": {
                    "text": "var:preset|color|gv-color-text-primary"
                }
            },
            "button": {
                "typography": {
                    "fontFamily": "var:preset|font-family|almarai",
                    "fontWeight": "300"
                }
            }
        },
        "typography": {
            "fontFamily": "var:preset|font-family|almarai"
        },
